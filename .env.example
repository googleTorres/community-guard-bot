# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token

# Group to protect. Supergroup IDs start with -100. Add @username_to_id_bot to the group to get it.
GROUP_ID=-1001234567890

# Telegram user IDs allowed to use /stats (JSON list)
ADMIN_IDS=[123456789]

# Local run uses SQLite. docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Verification
CAPTCHA_TIMEOUT=120

# Anti-spam
NEW_USER_MESSAGES=5
FLOOD_LIMIT=5
FLOOD_WINDOW=10
MAX_STRIKES=3
MUTE_MINUTES=60
BANNED_WORDS=["casino", "free crypto", "dm me for profit"]

LEADERBOARD_SIZE=10
